import { Tr, Theme } from "../common.slint";
import {
    CustomLineEdit,
    CustomButton,
    SectionCard,
    SectionHeader,
} from "../components/custom_themed_widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component CommandPaletteWindow inherits Window {
    title: Tr.command-palette-window-title;
    icon: @image-url("../../assets/icon.svg");
    background: Theme.bg;
    preferred-width: 620px;
    preferred-height: 520px;
    default-font-family: "Miranda Sans";
    default-font-size: 14px;

    in-out property <string> command-search: "";
    in property <[string]> command-options: [Tr.command-palette-no-available];
    in-out property <int> command-index: 0;

    callback apply-filter();
    callback run-selected();
    callback close-requested();
    callback key-pressed(/* key */ string, /* shift_pressed */ bool) -> bool;

    changed command-search => {
        root.apply-filter();
    }

    changed command-index => {
        let item-y = command-scroll.viewport-y + root.command-index * 44px;
        if item-y < 0px {
            command-scroll.viewport-y += 0px - item-y;
        } else if item-y + 38px > command-scroll.visible-height {
            command-scroll.viewport-y -= item-y + 38px - command-scroll.visible-height;
        }
    }

    VerticalLayout {
        spacing: 10px;
        padding: 14px;

        SectionCard {
            SectionHeader {
                icon: @image-url("../../assets/ui-icons/option-menu.svg");
                title: Tr.command-palette-title;
                helper: Tr.command-palette-helper;
            }

            CustomLineEdit {
                height: 36px;
                text <=> root.command-search;
                placeholder: Tr.command-palette-search-placeholder;
                accessible-label-text: Tr.command-palette-search-placeholder;
            }
        }

        SectionCard {
            SectionHeader {
                icon: @image-url("../../assets/ui-icons/option-settings.svg");
                title: Tr.command-palette-commands-title;
                helper: Tr.command-palette-commands-helper;
            }

            command-scroll := ScrollView {
                height: 320px;
                viewport-width: self.width;
                accessible-role: list;
                accessible-label: Tr.command-palette-commands-title;

                VerticalLayout {
                    width: parent.width;
                    spacing: 6px;

                    for command[index] in root.command-options: Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: root.command-index == index ? Theme.accent.with-alpha(60%) : Theme.border.with-alpha(42%);
                        background: root.command-index == index ? Theme.accent-soft.with-alpha(28%) : row-touch.has-hover ? Theme.surface.with-alpha(52%) : Theme.surface.with-alpha(28%);
                        accessible-role: list-item;
                        accessible-label: command;
                        accessible-action-default => {
                            root.command-index = index;
                            root.run-selected();
                        }

                        Text {
                            x: 10px;
                            y: 9px;
                            width: parent.width - 20px;
                            text: command;
                            color: Theme.text;
                            font-size: 12.5px;
                            overflow: elide;
                        }

                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.command-index = index;
                            }
                            double-clicked => {
                                root.command-index = index;
                                root.run-selected();
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;

                CustomButton {
                    height: 34px;
                    text: Tr.command-palette-run;
                    clicked => {
                        root.run-selected();
                    }
                }

                CustomButton {
                    height: 34px;
                    text: Tr.action-close;
                    clicked => {
                        root.close-requested();
                    }
                }
            }
        }
    }

    forward-focus: key-handler;
    key-handler := FocusScope {
        key-pressed(event) => {
            if event.text == Key.DownArrow {
                root.command-index = min(root.command-options.length - 1, root.command-index + 1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.command-index = max(0, root.command-index - 1);
                return accept;
            }
            if event.text == Key.Home {
                root.command-index = 0;
                return accept;
            }
            if event.text == Key.End {
                root.command-index = max(0, root.command-options.length - 1);
                return accept;
            }
            if root.key-pressed(event.text, event.modifiers.shift) {
                return accept;
            }
            reject
        }
    }
}
