{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "▶️ Dev",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "--locked"],
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "🧪 Test",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "--all-targets", "--locked"],
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "🧹 Lint",
            "type": "shell",
            "command": "cargo",
            "args": [
                "clippy",
                "--all-targets",
                "--locked",
                "--",
                "-D",
                "warnings",
                "-W",
                "clippy::pedantic"
            ],
            "problemMatcher": ["$rustc"],
            "group": "test"
        },
        {
            "label": "🎨 Format",
            "type": "shell",
            "command": "cargo",
            "args": ["fmt"],
            "group": "build"
        },
        {
            "label": "✅ Format check",
            "type": "shell",
            "command": "cargo",
            "args": ["fmt", "--", "--check"],
            "group": "build"
        },
        {
            "label": "🔍 Check",
            "type": "shell",
            "command": "cargo",
            "args": ["check", "--locked"],
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "🛠️ Build",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--locked"],
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "🚀 Release",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--release", "--locked"],
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "📚 Docs",
            "type": "shell",
            "command": "cargo",
            "args": ["doc", "--no-deps", "--locked"],
            "problemMatcher": ["$rustc"],
            "group": "build"
        },
        {
            "label": "🔐 Audit",
            "detail": "Audit Cargo.lock. Keep unmaintained transitive warnings visible.",
            "type": "shell",
            "command": "cargo",
            "args": ["audit"],
            "problemMatcher": ["$rustc"],
            "group": "test"
        },
        {
            "label": "📦 Deps",
            "type": "shell",
            "command": "cargo",
            "args": ["update", "--dry-run"],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "🧼 Clean",
            "type": "shell",
            "command": "cargo",
            "args": ["clean"],
            "group": "build"
        },
        {
            "label": "♻️ CI",
            "dependsOrder": "sequence",
            "dependsOn": [
                "✅ Format check",
                "🔍 Check",
                "🧹 Lint",
                "🧪 Test",
                "🚀 Release",
                "📚 Docs",
                "🔐 Audit"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
