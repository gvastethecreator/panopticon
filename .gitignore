# ── Build artefacts ───────────────────────────────────────────
/target/
**/*.rs.bk
/dist/
/installer/output/
/installer/*.exe
/installer/*.msi
/panopticon-*-x86_64-pc-windows-msvc/
/panopticon-*-x86_64-pc-windows-msvc.zip
/panopticon-*-setup.exe
*.pdb

# ── IDE / editor ─────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/tasks.json
*.swp
*.swo
*~

# ── Local-only working areas (not for public repo) ──────────
.agents/
.opencode/
.local/
/.scratch/
# Private planning documents and abandoned scaffolds inside docs/.
docs/panopticon_improvement_prd/
docs/book/

# ── OS files ─────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx

# ── Coverage reports ─────────────────────────────────────────
tarpaulin-report.html
lcov.info

# ── Logs (generated at runtime) ──────────────────────────────
/logs/
*.log
*.tmp
test_output.txt

# ── Code-map staging (published maps remain tracked) ─────────
/docs/codemap/.staging*/

# ── Backup files from refactoring ────────────────────────────
*.bak
*.orig

# ── Temporary / smoke-test outputs ──────────────────────────
/temp/
smoke_stdout.txt
smoke_stderr.txt

# ── Maintainer-only development scripts ─────────────────────
# download_icons.ps1 and gui_smoke_settings.ps1 were internal
# one-off scripts; the icon URLs are already realised in
# assets/ui-icons/ and the GUI smoke test is host-specific.
/download_icons.ps1
/gui_smoke_settings.ps1
